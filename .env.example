# 数据库后端选择: "leancloud" 或 "supabase"
DATA_BACKEND="leancloud"

# LeanCloud 配置（DATA_BACKEND="leancloud" 时需要）
LEANCLOUD_APP_ID=""
LEANCLOUD_APP_KEY=""
LEANCLOUD_SERVER_URL=""

# Supabase 配置（DATA_BACKEND="supabase" 时需要）
# 在 Supabase 控制台 Project Settings → API 中获取
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# 允许访问的 Referer 域名（逗号分隔）
HOSTS="localhost, xaoxuu.com, xaox.cc"
